# ──────────────────────────────────────────────────────────────
# Reply2Quote — Environment Variables
# Copy this file to .env.local for local development, and add the
# same values in your Vercel Project Settings → Environment Variables
# for production/preview deployments.
# ──────────────────────────────────────────────────────────────

# Supabase — from your project's Settings → API page
# Safe to expose in the browser (public, protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service role key — SERVER-SIDE ONLY, never exposed to the browser.
# Used only for trusted server operations (currently not required by any
# route, kept here so it's ready if a future admin task needs it).
# Keep this secret. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI provider — server-side only, used by /api/ai/analyze
# Any OpenAI-compatible endpoint works (OpenAI, Azure OpenAI, etc).
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# Override only if using an OpenAI-compatible proxy/gateway.
OPENAI_BASE_URL=https://api.openai.com/v1

# App URL — used to build absolute links (e.g. auth redirects).
# Set to your production domain when deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
